# Senha necessaria para liberar o botao de download do modpack.
# Nao commitar o .env.local de verdade — so esse exemplo.
DOWNLOAD_PASSWORD=troque-por-uma-referencia-de-attack-on-titan

# Supabase — fonte do conteudo do ModCodex (mods/itens/receitas/tutoriais/
# origins). So a anon key e usada em runtime (RLS ja garante leitura publica,
# sem policy de escrita anonima). Pegue os valores em vercel env pull, ou no
# dashboard do Supabase em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=troque-pela-anon-key-do-projeto
